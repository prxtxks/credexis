{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "next-env.d.ts"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "eval": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
