{
  "name": "credexis",
  "version": "0.0.0",
  "private": true,
  "description": "Credexis — SBA 7(a) underwriting automation. Documents in, banker-grade pro-forma out.",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run build --filter='./packages/*' && vitest run",
    "test:coverage": "turbo run build --filter='./packages/*' && vitest run --coverage",
    "test:e2e": "pnpm --filter @credexis/web test:e2e",
    "eval": "turbo run eval",
    "db:generate": "pnpm --filter @credexis/schema db:generate",
    "db:migrate": "pnpm --filter @credexis/schema run build && pnpm --filter @credexis/schema db:migrate",
    "db:migrate:api": "pnpm --filter @credexis/schema run build && cd packages/schema && node dist/db/migrate-api.js",
    "prepare": "husky",
    "db:seed": "pnpm --filter @credexis/schema run build && cd packages/schema && node dist/db/seed-api.js",
    "db:check-drift": "pnpm --filter @credexis/schema db:check-drift",
    "check:client-math": "node tooling/scripts/check-client-math.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@typescript-eslint/rule-tester": "8.39.0",
    "@typescript-eslint/utils": "8.39.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.33.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.5",
    "prettier": "3.6.2",
    "turbo": "2.9.14",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0",
    "vitest": "3.2.6"
  },
  "pnpm": {
    "overrides": {
      "@trpc/server": ">=11.8.0",
      "@trpc/client": ">=11.8.0",
      "@trpc/react-query": ">=11.8.0",
      "drizzle-orm": ">=0.45.2",
      "playwright": ">=1.55.1",
      "playwright-core": ">=1.55.1",
      "@playwright/test": ">=1.55.1",
      "ws": ">=8.21.0",
      "yaml": ">=2.8.3",
      "postcss": ">=8.5.10",
      "uuid": ">=11.1.1",
      "@opentelemetry/core": ">=2.8.0",
      "cookie": ">=0.7.0",
      "tar": ">=7.5.19",
      "fast-uri": ">=3.1.4",
      "sharp": ">=0.35.0",
      "engine.io": ">=6.6.7",
      "esbuild": ">=0.25.0",
      "@hono/node-server": ">=2.0.5",
      "vitest": ">=3.2.6",
      "turbo": ">=2.9.14",
      "brace-expansion": ">=5.0.8"
    }
  }
}
