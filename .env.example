# Credexis — environment variable template.
#
# Copy to `.env.local` (gitignored) and fill values from your secret manager.
# NEVER commit real values. `NEXT_PUBLIC_*` vars are exposed to the browser —
# put nothing sensitive behind that prefix. Everything else is server-only.
#
# Which of these services are actually provisioned/live is tracked in
# docs/environments.md (see M0.5 [PRATIK]).

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Supabase (Postgres / Auth / Storage)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — MUST NOT appear in any request path (Iron Law #7).
# Used only by pipeline workers / migrations with explicit tenant scoping.
SUPABASE_SERVICE_ROLE_KEY=
# Pooled connection string for the app; direct connection for Drizzle migrations.
DATABASE_URL=
DIRECT_URL=

# ---------------------------------------------------------------------------
# Trigger.dev v4 (durable pipeline jobs)
# ---------------------------------------------------------------------------
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=
# Personal access token (tr_pat_…) — needed only to DEPLOY the pipeline tasks
# (`pnpm --filter @credexis/pipeline trigger:deploy`), never at runtime.
TRIGGER_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Extraction vendors (behind ExtractorAdapter — env-gated; bake-off in M3.4)
# All LLM/extraction vendors must be on zero-data-retention tiers (tax PII).
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
REDUCTO_API_KEY=
EXTEND_API_KEY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ---------------------------------------------------------------------------
# IRS transcripts (TranscriptProvider — M9; optional, feature-flagged per deal)
# ---------------------------------------------------------------------------
TRANSCRIPT_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# Observability (Sentry)
# ---------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Google OAuth provider (M2.3) — created in Google Cloud Console by [PRATIK];
# used once via Management API to enable the provider in Supabase Auth.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Supabase Management API (token-only ops model — see environments.md):
# migrations/seeds applied via the query endpoint, no DB password needed.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Server-side Supabase URL for the pipeline worker (same value as
# NEXT_PUBLIC_SUPABASE_URL; separate name because workers run outside Next).
SUPABASE_URL=

# IRS transcript provider (M9) — provider id + key; null provider until
# ADR-0003 selects one.
TRANSCRIPT_PROVIDER=

# Dev-only flags (never set in CI/prod): EVAL_EXTRACTOR, EVAL_NO_BATCH,
# RUN_LIVE_VENDOR_TESTS, RUN_LIVE_E2E — see docs/environments.md.
