{
  "name": "@credexis/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "pnpm run build && drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "db:migrate:api": "node dist/db/migrate-api.js",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "db:seed:api": "node dist/db/seed-api.js",
    "db:check-drift": "pnpm run build && node scripts/check-drift.mjs"
  },
  "devDependencies": {
    "@types/node": "24.2.0",
    "drizzle-kit": "0.31.4",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "drizzle-orm": "0.44.4",
    "postgres": "3.4.7",
    "zod": "3.25.76"
  }
}
