{
  "name": "@credexis/corpus-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "corpus": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@credexis/schema": "workspace:*",
    "pdf-lib": "1.17.1",
    "unpdf": "1.3.2",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "24.2.0",
    "typescript": "5.9.2"
  }
}
