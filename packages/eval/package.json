{
  "name": "@credexis/eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "node dist/run-eval.js",
    "signals": "node dist/signal-sweep/cli.js",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@credexis/corpus-tools": "workspace:*",
    "@credexis/engine": "workspace:*",
    "@credexis/extraction": "workspace:*",
    "@credexis/pipeline": "workspace:*",
    "@credexis/schema": "workspace:*",
    "@credexis/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.2.0",
    "typescript": "5.9.2"
  }
}
