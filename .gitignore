# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
out/
.turbo/
*.tsbuildinfo

# Next.js auto-generated (regenerated by `next build`/`dev`)
next-env.d.ts

# Test / coverage
coverage/
playwright-report/
test-results/
.playwright/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Env files (values never in git)
.env
.env.*
!.env.example

# Secrets & credentials — NEVER commit.
# V1 leaked a live GCP service-account *.json at the repo root because
# .gitignore only covered .env* and *.pem. These filename patterns are the
# first line of defense; gitleaks (CI + local) is the content-based backstop
# that catches key material regardless of filename.
*.pem
*.key
*.p12
*.pfx
*-key.json
*.key.json
*credentials*.json
*service-account*.json
*serviceaccount*.json
gcp-*.json
service_account*.json
secrets/
.secrets/

# Golden corpus — PDFs never in git (PII + size); labels + manifest ARE tracked
corpus/pdfs/
corpus/synthetic/**/*.pdf

# Eval harness output (eval-baseline.json IS tracked; reports are not)
eval-output/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.drift-check/

# Sample/test tax documents (may contain real PII) — never in git
# (corpus rules: PDFs live in the private bucket, only hashed manifests
# are committed). Intern-provided material under analysis lives here.
docs/testing-docs/

# Local Trigger.dev CLI auth (contains a PAT) — never commit
.trigger-local-config/

# Trigger.dev CLI build artifacts
.trigger/

# Vercel UI reference screenshots (Pratik's captures — reference only, never shipped)
docs/Vercel-ui/
